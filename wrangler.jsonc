{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luxe-line",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "luxe-line" }],
  // ตัวแปรไม่ลับ (runtime) — ค่าที่ลับให้ตั้งด้วย `wrangler secret put <NAME>`:
  //   SESSION_SECRET, API_INTERNAL_TOKEN, LINE_LOGIN_CHANNEL_ID, LINE_MESSAGING_ACCESS_TOKEN, LINE_RICHMENU_MEMBER_ID
  // NEXT_PUBLIC_* ถูกฝังตอน build ต้องอยู่ใน .env.production / .env.local ก่อนสั่ง build
  "vars": { "EXTERNAL_API_BASE_URL": "https://api-ufabet.168csn.com", "LINE_LOGIN_CHANNEL_ID": "2011952564" }
}
