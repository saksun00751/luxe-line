# ---------- LineMember API ----------
# origin ของ backend (36office) — ไม่ต้องใส่ /api/line-member/v1 (ค่าเริ่มต้น https://api.36office.com)
# เอกสาร: <origin>/line-member/api-docs
EXTERNAL_API_BASE_URL=https://api.36office.com
# token ลับที่ Next.js ส่งใน header X-Internal-Token ให้ backend ยืนยันที่มา (ต้องตรงกับค่าฝั่ง backend)
API_INTERNAL_TOKEN=change-me-internal-token

# ---------- Session ----------
# สุ่มอย่างน้อย 32 ตัวอักษร: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-32chars

# ---------- LINE ----------
# LIFF app (อยู่ใต้ LINE Login channel)
NEXT_PUBLIC_LIFF_ID=your-liff-id
# Channel ID ของ LINE Login channel (ใช้ verify ID token ฝั่ง server)
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
# Messaging API channel (LINE OA) — ต้องอยู่ provider เดียวกับ LINE Login เพื่อให้ userId ตรงกัน
LINE_MESSAGING_ACCESS_TOKEN=your-channel-access-token
# (ไม่บังคับ) Rich menu สำหรับสมาชิก — จะ link ให้ผู้ใช้อัตโนมัติหลังสมัคร/เข้าสู่ระบบ
LINE_RICHMENU_MEMBER_ID=richmenu-xxxxxxxx  # ได้จาก scripts/setup-richmenu.mjs

# ---------- Brand / Contact ----------
NEXT_PUBLIC_BRAND_NAME=LUXE
NEXT_PUBLIC_LINE_OA_URL=https://line.me/R/ti/p/@your-oa-id
NEXT_PUBLIC_CONTACT_HOURS=ตลอด 24 ชั่วโมง
# gold | emerald | ocean | ruby | violet | platinum
NEXT_PUBLIC_DEFAULT_THEME=gold
SESSION_SECRET=sTtYdcHo2b5UZV14CZHIZ+qpNm9p0fGFRxZcmkWHZ5U=
